# Run outputs (regenerated by run.py / run_all.py; default <package>/output, env DNEC_OUT)
output/*
!output/README.md

# Python caches
__pycache__/
*.py[cod]
*.tmp
*.tmp[0-9]*

# Third-party builds (regenerated by third_party/smdr/fetch_and_build.py from the shipped, verified tarball)
third_party/smdr/build/

# Large caches written by full runs if DNEC_OUT points inside the package
**/cache/
*.npz.partial

# Optional Wolfram cross-check outputs written next to the scripts
higgs/04_cross_terms/C149_wolfram_out.json

# Editors / OS
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
Thumbs.db
